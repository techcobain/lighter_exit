# ── Build-time (baked into the client bundle by Vite) ────────────────────────

# Where the browser reaches the Lighter API. Default "/lighter-api" goes through
# this app's own server, which proxies to LIGHTER_API_URL (helps users whose
# region is blocked from the API directly). Set the upstream URL here to call
# the API straight from the browser instead.
# VITE_LIGHTER_API_BASE=/lighter-api

# Lighter L1 contract on Ethereum mainnet and the Lighter L2 chain id.
# VITE_LIGHTER_CONTRACT=0x3B4D794a66304F130a4Db8F2551B0070dfCf5ca7
# VITE_LIGHTER_CHAIN_ID=304

# API key slot (0-254) this page registers for unstaking. Keep it away from the
# slots the official apps use (0-9) so nothing of the user's gets overwritten.
# VITE_API_KEY_INDEX=250

# Optional: Ethereum JSON-RPC used for reads and receipt polling. Defaults to
# viem's public endpoint for mainnet.
# VITE_ETH_RPC_URL=

# Optional: WalletConnect Cloud project id. When set, a WalletConnect (QR)
# option is offered next to the injected wallets.
# VITE_WALLETCONNECT_PROJECT_ID=

# ── Runtime (server) ─────────────────────────────────────────────────────────

# PORT=8787
# Upstream the /lighter-api proxy forwards to.
# LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
