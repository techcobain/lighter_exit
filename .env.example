# ── Build-time (baked into the client bundle by Vite) ────────────────────────

# The page serves two separate Lighter deployments: Lighter (contract on
# Ethereum) and Lighter RH (contract on Robinhood Chain). The Lighter RH
# contract, chain ids and explorers are fixed in src/lib/environments.ts.

# Where the browser reaches each Lighter API. The defaults go through this
# app's own server, which proxies to LIGHTER_API_URL / LIGHTER_RH_API_URL (helps
# users whose region is blocked from the API directly). Set an upstream URL
# here to call that API straight from the browser instead.
# VITE_LIGHTER_API_BASE=/lighter-api
# VITE_LIGHTER_RH_API_BASE=/lighter-api-rh

# Lighter L1 contract on Ethereum mainnet and the Lighter L2 chain id.
# VITE_LIGHTER_CONTRACT=0x3B4D794a66304F130a4Db8F2551B0070dfCf5ca7
# Priority Transactions (createOrder, cancelAllOrders, withdraw, changePubKey,
# burnShares) go to L1CoreMessaging once ZkLighter leaves the legacy implementation.
# VITE_L1_CORE_MESSAGING_CONTRACT=0x183ef7195d443a3dA7EC1d7003BaCa1ff490757D
# VITE_LEGACY_ZKLIGHTER_IMPL=0x45a06c03eedc123c34a66bad4691d7ddb26a80a6
# auto (default) | core | legacy
# VITE_PRIORITY_ROUTE=auto
# VITE_LIGHTER_CHAIN_ID=304

# API key slot (0-254) this page registers for unstaking. Keep it away from the
# slots the official apps use (0-9) so nothing of the user's gets overwritten.
# VITE_API_KEY_INDEX=250

# Optional: JSON-RPC endpoints used for reads and receipt polling, on Ethereum
# and on Robinhood Chain. Each defaults to viem's public endpoint for the chain.
# These end up in the public bundle, so never use a URL that embeds a secret key.
# VITE_ETH_RPC_URL=
# VITE_RH_RPC_URL=

# Optional: WalletConnect Cloud project id. When set, a WalletConnect (QR)
# option is offered next to the injected wallets.
# VITE_WALLETCONNECT_PROJECT_ID=

# Testing only (staging): set to 1 to show a "force contract calls" switch.
# "Trading only" sends closing positions and cancelling orders to the contract;
# "Everything" also sends key registration and every other step that has a
# contract route, as if the API had refused the account. Leave unset in
# production.
# VITE_FORCE_L1_OPTION=

# ── Runtime (server) ─────────────────────────────────────────────────────────

# PORT=8787
# Upstreams the /lighter-api and /lighter-api-rh proxies forward to.
# LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
# LIGHTER_RH_API_URL=https://api.rh.lighter.xyz

# Proxy limits. Per client address: PROXY_RATE_BURST requests at once, refilled
# at PROXY_RATE_PER_MIN. Over the limit the proxy answers 429.
# PROXY_RATE_BURST=120
# PROXY_RATE_PER_MIN=240
# Largest POST body the proxy accepts (bytes) and most upstream requests in flight.
# PROXY_MAX_BODY_BYTES=262144
# PROXY_MAX_INFLIGHT=200
# Header carrying the real client address, set by the platform's edge (Railway
# sends X-Real-IP). Set it empty if nothing trusted sits in front of the server,
# otherwise clients could choose their own rate-limit bucket.
# CLIENT_IP_HEADER=x-real-ip

# Extra origins for the Content-Security-Policy's connect-src, space separated.
# The build already records the RPC and WalletConnect origins it was configured
# with (dist/csp.json), so this is only for something added outside the build.
# CSP_CONNECT_SRC=
